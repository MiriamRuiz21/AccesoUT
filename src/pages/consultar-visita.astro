---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Banner from '../components/Banner.astro';
import ChatWidget from '../components/ChatWidget.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Consultar Visita — UTSJR">
  <Header />

  <main>
    <Banner />

    <section class="lookup-container container reveal">
      <div class="lookup-card">
        <div class="lookup-header">
          <div class="lookup-icon"><i class="fas fa-search"></i></div>
          <h2>Consultar mis Visitas</h2>
          <p>Ingresa tu correo electrónico para ver el estado de tus visitas registradas.</p>
        </div>

        <!-- Paso 1: Ingresar correo -->
        <div id="stepCorreo">
          <div class="search-row">
            <input type="email" id="correoInput" placeholder="tu@correo.com" />
            <button class="btn-buscar" id="enviarCodigoBtn">
              <i class="fas fa-paper-plane"></i> Enviar código
            </button>
          </div>
        </div>

        <!-- Paso 2: Ingresar código de verificación -->
        <div id="stepCodigo" style="display:none">
          <div class="code-info">
            <i class="fas fa-envelope-open-text"></i>
            <p>Enviamos un código de 8 dígitos a <strong id="correoEnviado"></strong></p>
          </div>
          <div class="search-row">
            <input type="text" id="codigoInput" placeholder="Código de 8 dígitos" maxlength="8" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" />
            <button class="btn-buscar" id="verificarCodigoBtn">
              <i class="fas fa-check-circle"></i> Verificar
            </button>
          </div>
          <div class="code-actions">
            <button class="btn-link" id="reenviarCodigoBtn">
              <i class="fas fa-redo"></i> Reenviar código
            </button>
            <button class="btn-link" id="cambiarCorreoBtn">
              <i class="fas fa-arrow-left"></i> Cambiar correo
            </button>
          </div>
        </div>

        <!-- Paso 3: Sesión activa -->
        <div id="stepSesion" style="display:none">
          <div class="session-bar">
            <div class="session-info">
              <i class="fas fa-user-check"></i>
              <span>Sesión activa para <strong id="correoSesion"></strong></span>
            </div>
            <div class="session-actions">
              <span class="session-timer" id="sessionTimer"></span>
              <button class="btn-historial" id="verHistorialBtn">
                <i class="fas fa-clipboard-list"></i> Historial
              </button>
              <button class="btn-logout" id="cerrarSesionBtn">
                <i class="fas fa-sign-out-alt"></i> Cerrar sesión
              </button>
            </div>
          </div>
        </div>

        <div id="alertBox" class="alert-box" style="display:none"></div>
      </div>

    </section>
  </main>

  <!-- Modal de resultados de visitas -->
  <div class="visitas-modal-overlay" id="visitasModal">
    <div class="visitas-modal">
      <div class="visitas-modal-header">
        <h3><i class="fas fa-clipboard-list"></i> Mis Visitas</h3>
        <button class="modal-close-btn" id="cerrarVisitasModal">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <div class="visitas-modal-body" id="visitasModalBody">
        <!-- Contenido dinámico -->
      </div>
      <div class="visitas-modal-footer">
        <button class="btn-cerrar-visitas" id="cerrarVisitasBtn">
          <i class="fas fa-times-circle"></i> Cerrar
        </button>
      </div>
    </div>
  </div>

  <ChatWidget />
  <Footer />
</Layout>

<style>
  .lookup-container {
    padding: 3rem 0;
    max-width: 750px;
    margin: 0 auto;
  }

  .lookup-card {
    background: var(--color-card, #fff);
    border: 1px solid var(--color-border, #eee);
    border-radius: var(--radius-lg, 16px);
    padding: 40px;
    box-shadow: var(--shadow-md);
  }

  .lookup-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .lookup-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--gradient-button, linear-gradient(135deg, #00A688, #00C9A4));
    color: white;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    box-shadow: var(--shadow-accent);
  }

  .lookup-header h2 {
    color: var(--color-primary);
    margin-bottom: 8px;
    -webkit-text-fill-color: var(--color-primary);
    background: none;
  }

  .lookup-header p {
    color: var(--color-text-light, #718096);
    font-size: 0.95rem;
  }

  .search-row {
    display: flex;
    gap: 12px;
  }

  .search-row input {
    flex: 1;
    margin-bottom: 0;
  }

  .btn-buscar {
    padding: 12px 24px;
    border: none;
    border-radius: var(--radius-sm, 8px);
    background: linear-gradient(135deg, #00A688, #00C9A4);
    color: white;
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 14px rgba(0, 166, 136, 0.25);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .btn-buscar:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 166, 136, 0.4);
  }

  .btn-buscar:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  /* Code verification step */
  .code-info {
    text-align: center;
    margin-bottom: 20px;
    color: var(--color-text-light, #718096);
    font-size: 0.93rem;
  }

  .code-info i {
    font-size: 2rem;
    color: var(--color-accent, #00A688);
    display: block;
    margin-bottom: 10px;
  }

  .code-info strong {
    color: var(--color-primary, #0F4C75);
  }

  .code-actions {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 14px;
  }

  .btn-link {
    background: none;
    border: none;
    color: var(--color-accent, #00A688);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 0;
    transition: opacity 0.2s;
  }

  .btn-link:hover {
    opacity: 0.75;
    text-decoration: underline;
  }

  .btn-link:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: none;
  }

  /* Session bar */
  .session-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(0, 166, 136, 0.08);
    border: 1px solid rgba(0, 166, 136, 0.2);
    border-radius: var(--radius-sm, 8px);
    padding: 12px 18px;
    gap: 12px;
    flex-wrap: wrap;
  }

  .session-info {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--color-text, #333);
  }

  .session-info i {
    color: var(--color-accent, #00A688);
    font-size: 1.1rem;
  }

  .session-info strong {
    color: var(--color-primary, #0F4C75);
  }

  .session-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .session-timer {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-muted, #A0AEC0);
    font-family: var(--font-heading, 'Outfit', sans-serif);
  }

  .btn-historial {
    padding: 6px 14px;
    border: 1.5px solid var(--color-accent, #00A688);
    border-radius: var(--radius-sm, 8px);
    background: transparent;
    color: var(--color-accent, #00A688);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.25s ease;
  }

  .btn-historial:hover {
    background: var(--color-accent, #00A688);
    color: white;
  }

  .btn-logout {
    padding: 6px 14px;
    border: 1.5px solid #ef4444;
    border-radius: var(--radius-sm, 8px);
    background: transparent;
    color: #ef4444;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.25s ease;
  }

  .btn-logout:hover {
    background: #ef4444;
    color: white;
  }

  #codigoInput {
    text-align: center;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    font-family: var(--font-heading, 'Outfit', sans-serif);
  }

  /* Alert */
  .alert-box {
    padding: 12px 16px;
    border-radius: var(--radius-sm, 8px);
    margin-top: 16px;
    font-size: 0.9rem;
  }

  .alert-box.alert-error {
    background: rgba(220, 53, 69, 0.1);
    color: #dc3545;
    border: 1px solid rgba(220, 53, 69, 0.25);
  }

  .alert-box.alert-info {
    background: rgba(0, 166, 136, 0.08);
    color: var(--color-accent, #00A688);
    border: 1px solid rgba(0, 166, 136, 0.2);
  }

  /* ── Modal de Visitas ── */
  .visitas-modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    z-index: 99999;
    justify-content: center;
    align-items: center;
    padding: 20px;
  }

  .visitas-modal-overlay.activo {
    display: flex;
  }

  .visitas-modal {
    background: var(--color-card, #fff);
    border-radius: var(--radius-lg, 16px);
    max-width: 560px;
    width: 100%;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.25);
    animation: modalSlideIn 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    overflow: hidden;
  }

  @keyframes modalSlideIn {
    from { opacity: 0; transform: scale(0.9) translateY(30px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .visitas-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 28px;
    background: linear-gradient(135deg, #0F4C75, #0D1B2A);
    color: white;
  }

  .visitas-modal-header h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: white;
    -webkit-text-fill-color: white;
    background: none;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .modal-close-btn {
    background: rgba(255,255,255,0.15);
    border: none;
    color: white;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    font-size: 0.95rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s ease;
  }

  .modal-close-btn:hover {
    background: rgba(255,255,255,0.3);
    transform: rotate(90deg);
  }

  .visitas-modal-body {
    padding: 24px 28px;
    overflow-y: auto;
    flex: 1;
  }

  .visitas-modal-footer {
    padding: 16px 28px;
    border-top: 1px solid var(--color-border, #eee);
    text-align: center;
  }

  .btn-cerrar-visitas {
    padding: 10px 32px;
    border: none;
    border-radius: var(--radius-sm, 8px);
    background: linear-gradient(135deg, #0F4C75, #0D1B2A);
    color: white;
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .btn-cerrar-visitas:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(15, 76, 117, 0.35);
  }

  /* ── Visita Card dentro del modal ── */
  .visita-card {
    background: var(--color-bg-warm, #FAFBFD);
    border: 1px solid var(--color-border, #eee);
    border-radius: var(--radius-md, 12px);
    padding: 20px;
    margin-bottom: 16px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .visita-card:last-child {
    margin-bottom: 0;
  }

  .visita-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  /* Barra lateral de estado */
  .visita-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 5px;
    height: 100%;
    border-radius: 12px 0 0 12px;
  }

  .visita-card.pendiente::before  { background: linear-gradient(180deg, #f59e0b, #d97706); }
  .visita-card.aprobada::before   { background: linear-gradient(180deg, #10b981, #059669); }
  .visita-card.cancelada::before  { background: linear-gradient(180deg, #ef4444, #dc2626); }
  .visita-card.finalizada::before { background: linear-gradient(180deg, #6b7280, #4b5563); }

  /* Icono grande de estado */
  .estado-icon-big {
    text-align: center;
    margin-bottom: 12px;
  }

  .estado-icon-big i {
    font-size: 2.2rem;
  }

  .estado-icon-big.pendiente i  { color: #f59e0b; }
  .estado-icon-big.aprobada i   { color: #10b981; }
  .estado-icon-big.cancelada i  { color: #ef4444; }
  .estado-icon-big.finalizada i { color: #6b7280; }

  .visita-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    padding-left: 8px;
  }

  .visita-depto {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-primary, #0F4C75);
  }

  .badge-estado {
    padding: 5px 16px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge-estado.pendiente  { background: #fef3c7; color: #92400e; }
  .badge-estado.aprobada   { background: #d1fae5; color: #065f46; }
  .badge-estado.cancelada  { background: #fee2e2; color: #991b1b; }
  .badge-estado.finalizada { background: #f3f4f6; color: #374151; }

  .visita-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    font-size: 0.88rem;
    padding-left: 8px;
  }

  .visita-info-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .visita-info-item strong {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted, #A0AEC0);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .visita-info-item strong i {
    font-size: 0.72rem;
    color: var(--color-accent, #00A688);
  }

  .visita-info-item span {
    color: var(--color-text, #333);
    font-weight: 500;
  }

  /* Separador entre visitas */
  .visita-separator {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-border, #eee), transparent);
    margin: 8px 0;
  }

  .btn-resend {
    margin-top: 14px;
    padding: 8px 18px;
    background: transparent;
    color: var(--color-accent, #00A688);
    border: 2px solid var(--color-accent, #00A688);
    border-radius: var(--radius-sm, 8px);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 8px;
  }

  .btn-resend:hover {
    background: var(--color-accent, #00A688);
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 166, 136, 0.3);
  }

  .btn-resend:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .empty-state {
    text-align: center;
    padding: 40px 20px;
  }

  .empty-state i {
    font-size: 3.5rem;
    margin-bottom: 16px;
    display: block;
    color: var(--color-text-muted, #A0AEC0);
    opacity: 0.35;
  }

  .empty-state p {
    color: var(--color-text-muted, #A0AEC0);
    font-size: 0.95rem;
  }

  /* Contador de visitas */
  .visitas-count {
    text-align: center;
    margin-bottom: 18px;
    font-size: 0.85rem;
    color: var(--color-text-light, #718096);
  }

  .visitas-count strong {
    color: var(--color-accent, #00A688);
  }

  @media (max-width: 576px) {
    .search-row {
      flex-direction: column;
    }
    .visitas-modal {
      max-height: 90vh;
    }
    .visita-info {
      grid-template-columns: 1fr;
    }
    .visita-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>

<script>
  import { endpoints } from '../config/api.js';

  function initLookup() {
    // --- Elementos del DOM ---
    const stepCorreo = document.getElementById('stepCorreo')!;
    const stepCodigo = document.getElementById('stepCodigo')!;
    const stepSesion = document.getElementById('stepSesion')!;
    const correoInput = document.getElementById('correoInput') as HTMLInputElement;
    const enviarCodigoBtn = document.getElementById('enviarCodigoBtn') as HTMLButtonElement;
    const codigoInput = document.getElementById('codigoInput') as HTMLInputElement;
    const verificarCodigoBtn = document.getElementById('verificarCodigoBtn') as HTMLButtonElement;
    const reenviarCodigoBtn = document.getElementById('reenviarCodigoBtn') as HTMLButtonElement;
    const cambiarCorreoBtn = document.getElementById('cambiarCorreoBtn') as HTMLButtonElement;
    const cerrarSesionBtn = document.getElementById('cerrarSesionBtn') as HTMLButtonElement;
    const verHistorialBtn = document.getElementById('verHistorialBtn') as HTMLButtonElement;
    const correoEnviado = document.getElementById('correoEnviado')!;
    const correoSesion = document.getElementById('correoSesion')!;
    const sessionTimer = document.getElementById('sessionTimer')!;
    const alertBox = document.getElementById('alertBox')!;

    const modal = document.getElementById('visitasModal')!;
    const modalBody = document.getElementById('visitasModalBody')!;
    const cerrarModalBtn = document.getElementById('cerrarVisitasModal');
    const cerrarModalFooter = document.getElementById('cerrarVisitasBtn');

    // --- Estado en memoria (no localStorage) ---
    let correoActual = '';
    let challengeId = '';
    let browserSecret = '';
    let accessToken = '';
    let sessionExpiresAt = 0;
    let timerInterval: ReturnType<typeof setInterval> | null = null;

    // --- Helpers ---
    function showStep(step: 'correo' | 'codigo' | 'sesion') {
      stepCorreo.style.display = step === 'correo' ? '' : 'none';
      stepCodigo.style.display = step === 'codigo' ? '' : 'none';
      stepSesion.style.display = step === 'sesion' ? '' : 'none';
      hideAlert();
    }

    function showAlert(msg: string, type: 'error' | 'info') {
      alertBox.className = `alert-box alert-${type}`;
      alertBox.textContent = msg;
      alertBox.style.display = 'block';
    }

    function hideAlert() {
      alertBox.style.display = 'none';
    }

    function setButtonLoading(btn: HTMLButtonElement, loading: boolean, defaultHTML: string) {
      btn.disabled = loading;
      btn.innerHTML = loading
        ? '<i class="fas fa-spinner fa-spin"></i> Espera...'
        : defaultHTML;
    }

    function abrirModal() {
      modal.classList.add('activo');
      document.body.style.overflow = 'hidden';
    }

    function cerrarModal() {
      modal.classList.remove('activo');
      document.body.style.overflow = '';
    }

    cerrarModalBtn?.addEventListener('click', cerrarModal);
    cerrarModalFooter?.addEventListener('click', cerrarModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) cerrarModal();
    });

    function formatFecha(iso: string) {
      return new Date(iso).toLocaleDateString('es-MX', {
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
        timeZone: 'America/Mexico_City'
      });
    }

    function getEstadoIcon(estado: string) {
      switch (estado) {
        case 'aprobada':   return 'fa-check-circle';
        case 'pendiente':  return 'fa-clock';
        case 'cancelada':  return 'fa-times-circle';
        case 'finalizada': return 'fa-flag-checkered';
        default:           return 'fa-question-circle';
      }
    }

    // --- Temporizador de sesión ---
    function startSessionTimer(expiresIn: number) {
      sessionExpiresAt = Date.now() + expiresIn * 1000;
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        const remaining = Math.max(0, Math.floor((sessionExpiresAt - Date.now()) / 1000));
        const mins = Math.floor(remaining / 60);
        const secs = remaining % 60;
        sessionTimer.textContent = `${mins}:${secs.toString().padStart(2, '0')}`;
        if (remaining <= 0) {
          clearInterval(timerInterval!);
          timerInterval = null;
          handleSessionExpired();
        }
      }, 1000);
    }

    function handleSessionExpired() {
      accessToken = '';
      challengeId = '';
      browserSecret = '';
      showStep('correo');
      correoInput.value = correoActual;
      showAlert('Tu sesión ha expirado. Solicita un nuevo código para continuar.', 'info');
    }

    function clearSession() {
      accessToken = '';
      challengeId = '';
      browserSecret = '';
      correoActual = '';
      sessionExpiresAt = 0;
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
      }
    }

    // --- PASO 1: Solicitar código ---
    async function solicitarCodigo() {
      const correo = correoInput.value.trim();
      if (!correo) {
        showAlert('Ingresa tu correo electrónico.', 'error');
        return;
      }

      setButtonLoading(enviarCodigoBtn, true, '<i class="fas fa-paper-plane"></i> Enviar código');
      hideAlert();

      try {
        const res = await fetch(endpoints.requestCode, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'ngrok-skip-browser-warning': 'true'
          },
          body: JSON.stringify({ correo })
        });

        if (res.status === 429) {
          showAlert('Demasiados intentos. Espera unos minutos antes de solicitar otro código.', 'error');
          return;
        }

        const json = await res.json();

        if (res.status === 202 && json.challengeId) {
          correoActual = correo;
          challengeId = json.challengeId;
          browserSecret = json.browserSecret;
          correoEnviado.textContent = correo;
          codigoInput.value = '';
          showStep('codigo');
          codigoInput.focus();
        } else {
          showAlert(json.error || 'No se pudo enviar el código. Intenta de nuevo.', 'error');
        }
      } catch {
        showAlert('Error de conexión con el servidor.', 'error');
      } finally {
        setButtonLoading(enviarCodigoBtn, false, '<i class="fas fa-paper-plane"></i> Enviar código');
      }
    }

    // --- PASO 2: Verificar código ---
    async function verificarCodigo() {
      const code = codigoInput.value.trim();
      if (!code || code.length !== 8) {
        showAlert('Ingresa el código de 8 dígitos que recibiste por correo.', 'error');
        return;
      }

      setButtonLoading(verificarCodigoBtn, true, '<i class="fas fa-check-circle"></i> Verificar');
      hideAlert();

      try {
        const res = await fetch(endpoints.verifyCode, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'ngrok-skip-browser-warning': 'true'
          },
          body: JSON.stringify({ challengeId, browserSecret, code })
        });

        if (res.status === 401) {
          const json = await res.json().catch(() => ({}));
          showAlert(json.error || 'Código incorrecto, vencido o agotado. Solicita uno nuevo.', 'error');
          return;
        }

        if (res.status === 429) {
          showAlert('Demasiados intentos. Espera unos minutos.', 'error');
          return;
        }

        const json = await res.json();

        if (res.ok && json.accessToken) {
          accessToken = json.accessToken;
          correoSesion.textContent = correoActual;
          showStep('sesion');
          startSessionTimer(json.expiresIn || 900);
          buscarVisitas();
        } else {
          showAlert(json.error || 'No se pudo verificar el código.', 'error');
        }
      } catch {
        showAlert('Error de conexión con el servidor.', 'error');
      } finally {
        setButtonLoading(verificarCodigoBtn, false, '<i class="fas fa-check-circle"></i> Verificar');
      }
    }

    // --- PASO 3: Consultar visitas con token ---
    async function buscarVisitas() {
      if (!accessToken) return;

      try {
        const res = await fetch(`${endpoints.lookup}?correo=${encodeURIComponent(correoActual)}`, {
          headers: {
            'Authorization': `Bearer ${accessToken}`,
            'ngrok-skip-browser-warning': 'true'
          }
        });

        if (res.status === 401) {
          handleSessionExpired();
          return;
        }

        const json = await res.json();

        if (res.ok) {
          renderVisitas(json.data, correoActual);
        } else {
          showAlert(json.error || 'Error al consultar visitas.', 'error');
        }
      } catch {
        showAlert('Error de conexión con el servidor.', 'error');
      }
    }

    // --- Cerrar sesión ---
    async function cerrarSesion() {
      try {
        await fetch(endpoints.logout, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${accessToken}`,
            'Content-Type': 'application/json',
            'ngrok-skip-browser-warning': 'true'
          }
        });
      } catch {
      }
      clearSession();
      showStep('correo');
      correoInput.value = '';
      showAlert('Sesión cerrada correctamente.', 'info');
    }

    // --- Render visitas ---
    function renderVisitas(visitas: any[], correo: string) {
      if (visitas.length === 0) {
        modalBody.innerHTML = `
          <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <p>No se encontraron visitas registradas para este correo.</p>
          </div>`;
        abrirModal();
        return;
      }

      const countHTML = `<div class="visitas-count">Se encontraron <strong>${visitas.length}</strong> visita${visitas.length > 1 ? 's' : ''} registrada${visitas.length > 1 ? 's' : ''}</div>`;

      const cards = visitas.map((v: any) => `
        <div class="visita-card ${v.estado}">
          <div class="estado-icon-big ${v.estado}">
            <i class="fas ${getEstadoIcon(v.estado)}"></i>
          </div>
          <div class="visita-header">
            <span class="visita-depto">${v.Departamentos?.nombre || 'Sin departamento'}</span>
            <span class="badge-estado ${v.estado}">${v.estado.charAt(0).toUpperCase() + v.estado.slice(1)}</span>
          </div>
          <div class="visita-info">
            <div class="visita-info-item">
              <strong><i class="fas fa-calendar-alt"></i> Fecha</strong>
              <span>${formatFecha(v.fecha)}</span>
            </div>
            <div class="visita-info-item">
              <strong><i class="fas fa-clock"></i> Hora</strong>
              <span>${v.hora_inicio}</span>
            </div>
            <div class="visita-info-item">
              <strong><i class="fas fa-map-marker-alt"></i> Ubicacion</strong>
              <span>${v.Departamentos?.ubicacion || 'N/A'}</span>
            </div>
            <div class="visita-info-item">
              <strong><i class="fas fa-comment"></i> Motivo</strong>
              <span>${v.motivo}</span>
            </div>
          </div>
          ${v.estado === 'aprobada' ? `
            <button class="btn-resend" data-id="${v.id}" data-correo="${correo}">
              <i class="fas fa-qrcode"></i> Reenviar QR a mi correo
            </button>
          ` : ''}
        </div>
      `).join('');

      modalBody.innerHTML = countHTML + cards;

      modalBody.querySelectorAll('.btn-resend').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const button = btn as HTMLButtonElement;
          button.disabled = true;
          button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enviando...';
          try {
            const res = await fetch(endpoints.resendQR, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${accessToken}`,
                'ngrok-skip-browser-warning': 'true'
              },
              body: JSON.stringify({
                visita_id: Number(button.dataset.id),
                correo: button.dataset.correo
              })
            });
            if (res.status === 401) {
              handleSessionExpired();
              cerrarModal();
              return;
            }
            if (res.ok) {
              button.innerHTML = '<i class="fas fa-check" style="color:#10b981"></i> QR enviado';
              button.style.borderColor = '#10b981';
              button.style.color = '#10b981';
            } else {
              button.innerHTML = '<i class="fas fa-times"></i> Error al enviar';
              button.style.borderColor = '#ef4444';
              button.style.color = '#ef4444';
            }
          } catch {
            button.innerHTML = '<i class="fas fa-times"></i> Error de conexión';
            button.style.borderColor = '#ef4444';
            button.style.color = '#ef4444';
          }
        });
      });

      abrirModal();
    }

    // --- Event listeners ---
    enviarCodigoBtn.addEventListener('click', solicitarCodigo);
    correoInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') solicitarCodigo();
    });

    verificarCodigoBtn.addEventListener('click', verificarCodigo);
    codigoInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') verificarCodigo();
    });

    reenviarCodigoBtn.addEventListener('click', async () => {
      reenviarCodigoBtn.disabled = true;
      reenviarCodigoBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Reenviando...';
      try {
        const res = await fetch(endpoints.requestCode, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'ngrok-skip-browser-warning': 'true'
          },
          body: JSON.stringify({ correo: correoActual })
        });

        if (res.status === 429) {
          showAlert('Demasiados intentos. Espera unos minutos antes de solicitar otro código.', 'error');
          return;
        }

        const json = await res.json();
        if (res.status === 202 && json.challengeId) {
          challengeId = json.challengeId;
          browserSecret = json.browserSecret;
          codigoInput.value = '';
          showAlert('Nuevo código enviado a tu correo.', 'info');
          codigoInput.focus();
        } else {
          showAlert(json.error || 'No se pudo reenviar el código.', 'error');
        }
      } catch {
        showAlert('Error de conexión.', 'error');
      } finally {
        reenviarCodigoBtn.disabled = false;
        reenviarCodigoBtn.innerHTML = '<i class="fas fa-redo"></i> Reenviar código';
      }
    });

    cambiarCorreoBtn.addEventListener('click', () => {
      challengeId = '';
      browserSecret = '';
      showStep('correo');
      correoInput.focus();
    });

    verHistorialBtn.addEventListener('click', buscarVisitas);
    cerrarSesionBtn.addEventListener('click', cerrarSesion);
  }

  document.addEventListener('DOMContentLoaded', initLookup);
  document.addEventListener('astro:page-load', initLookup);
</script>
